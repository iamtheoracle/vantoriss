{
  "name": "Monthly Transaction Ledger Export",
  "description": "Automatically exports all HeroBox/Vantoris financial transactions to CSV on the first day of each month for reconciliation and reporting.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 1 1 * *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "monthly_transaction_ledger_export",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "exportTransactionLedger",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  }
}