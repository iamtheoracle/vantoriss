{
  "name": "Monthly HeroBox Google Sheets Export",
  "description": "Automatically exports all HeroBox financial transactions to Google Sheets on the 1st of each month for accounting reconciliation.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 6 1 * *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "monthly_herobox_google_sheets_export",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "exportTransactionLedger",
            "args": {
              "export_type": "monthly",
              "format": "google_sheets"
            }
          },
          "then": "end"
        }
      }
    ]
  }
}