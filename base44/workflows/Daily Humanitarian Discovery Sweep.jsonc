{
  "name": "Daily Humanitarian Discovery Sweep",
  "description": "Daily scheduled workflow that executes a humanitarian discovery run to find legitimate, publicly documented assistance needs. Uses InvokeLLM with web search to discover and verify humanitarian cases. Never fabricates people, needs, or emergencies. Requires the humanitarianDiscoverySweep backend function (Builder+ plan).",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 0 8 * * *",
      "one_time_date": null,
      "timezone": "America/New_York",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "daily_humanitarian_discovery_sweep",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "humanitarianDiscoverySweep",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  }
}