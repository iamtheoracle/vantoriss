{
  "name": "Auto-Notify Member on Admin Message",
  "description": "Automatically creates a member notification when an admin sends a new message in a conversation thread",
  "trigger": {
    "condition": "${ (.trigger.data.sender == \"admin\") }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "ThreadMessage"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "auto_notify_member_on_admin_message",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "onThreadMessageCreate",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  }
}