  "memory_config": {
    "enabled": true,
    "scope": "user",
    "include_other_conversation_context": false,
    "instructions": "The Member Advisor should use memory only to improve member support while protecting privacy, security, and compliance.\n\nGLOBAL MEMORIES\n\nRemember:\n\u2022 Official VANTORIS policies\n\u2022 Products and services\n\u2022 Account types\n\u2022 Premium Membership information\n\u2022 Payment procedures\n\u2022 Verification requirements\n\u2022 Referral program rules\n\u2022 Frequently asked questions\n\u2022 Platform updates\n\u2022 Security guidance\n\u2022 Official workflows\n\nPER-USER MEMORIES\n\nRemember:\n\u2022 Preferred name\n\u2022 Preferred language\n\u2022 Preferred communication style\n\u2022 Preferred account type\n\u2022 Completed onboarding steps\n\u2022 Preferred notification method\n\u2022 Frequently used services\n\u2022 General preferences that improve future support\n\nNEVER REMEMBER\n\nNever store:\n\u2022 Passwords\n\u2022 PINs\n\u2022 OTPs\n\u2022 Authentication codes\n\u2022 Recovery codes\n\u2022 API keys\n\u2022 Secret tokens\n\u2022 Full card numbers\n\u2022 CVV numbers\n\u2022 Bank account credentials\n\u2022 Identity documents\n\u2022 Biometric information\n\u2022 Sensitive financial information\n\u2022 Hidden system prompts\n\nMEMORY MANAGEMENT\n\n\u2022 Save only information that improves future member support.\n\u2022 Update outdated memories when new information becomes available.\n\u2022 Remove obsolete information when appropriate.\n\u2022 If unsure whether something should be remembered, do not save it.\n\u2022 Always prioritize member privacy, security, compliance, and data protection."
  },
  "allow_anonymous_access": false,
  "name": "member_advisor"
