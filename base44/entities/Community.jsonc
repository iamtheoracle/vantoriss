{
  "name": "Community",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "department",
        "courses",
        "interests",
        "career",
        "sports",
        "music",
        "gaming",
        "faith",
        "technology",
        "business",
        "art"
      ]
    },
    "university": {
      "type": "string"
    },
    "icon_url": {
      "type": "string"
    },
    "member_count": {
      "type": "number",
      "default": 0
    },
    "created_by_id": {
      "type": "string"
    },
    "created_by_name": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "category"
  ]
}