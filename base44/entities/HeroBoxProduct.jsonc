{
  "name": "HeroBoxProduct",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Product name"
    },
    "category": {
      "type": "string",
      "enum": [
        "essential",
        "comfort",
        "body_care",
        "snack_food",
        "mobile_tech",
        "premium",
        "executive",
        "phones",
        "airtime_data",
        "subscriptions",
        "deployment_card",
        "groceries",
        "internet_access",
        "wifi_devices",
        "accessories",
        "baby_care",
        "elder_care",
        "health_essentials",
        "home_essentials",
        "clothing",
        "school_supplies",
        "mobility_support",
        "gifts"
      ],
      "description": "Product category / package stage"
    },
    "description": {
      "type": "string"
    },
    "image_url": {
      "type": "string"
    },
    "price": {
      "type": "number",
      "description": "Base price in USD"
    },
    "currency": {
      "type": "string",
      "default": "USD"
    },
    "destination": {
      "type": "string",
      "description": "Destination country/region this product is available for (empty = global)"
    },
    "availability": {
      "type": "string",
      "enum": [
        "available",
        "unavailable",
        "discontinued",
        "requires_config"
      ],
      "default": "available"
    },
    "source": {
      "type": "string",
      "description": "Partner/source name for this product"
    },
    "source_product_id": {
      "type": "string",
      "description": "External product ID from partner catalog"
    },
    "package_id": {
      "type": "string",
      "description": "If this product belongs to a predefined package, the package reference"
    },
    "discount": {
      "type": "number",
      "default": 0,
      "description": "Discount percentage (0-100)"
    },
    "shipping_required": {
      "type": "boolean",
      "default": true
    },
    "freshness_status": {
      "type": "string",
      "enum": [
        "fresh",
        "stale",
        "expired"
      ],
      "default": "fresh",
      "description": "Catalog data freshness — stale items cannot be purchased"
    },
    "retrieved_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the catalog data was last retrieved from source"
    },
    "specifications": {
      "type": "string",
      "description": "JSON-serialized product specifications (storage, condition, model, etc.)"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive"
      ],
      "default": "active"
    },
    "item_type": {
      "type": "string",
      "enum": [
        "physical",
        "digital_service",
        "package"
      ],
      "default": "physical",
      "description": "Whether the catalogue entry is a physical good, digital service or curated package."
    },
    "delivery_modes": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "delivery",
          "pickup",
          "digital"
        ]
      },
      "description": "Confirmed fulfilment modes supported by the source provider."
    },
    "provider_url": {
      "type": "string",
      "description": "Official provider or product URL for this listing."
    },
    "price_valid_until": {
      "type": "string",
      "format": "date-time",
      "description": "Time until which the quoted price is considered valid, when supplied by the provider."
    },
    "is_featured": {
      "type": "boolean",
      "default": false
    },
    "is_deal": {
      "type": "boolean",
      "default": false
    },
    "deal_label": {
      "type": "string"
    },
    "stock_status": {
      "type": "string",
      "enum": [
        "in_stock",
        "low_stock",
        "out_of_stock",
        "unknown"
      ],
      "default": "unknown"
    },
    "service_region": {
      "type": "string",
      "description": "Region or network coverage for digital services."
    }
  },
  "required": [
    "name",
    "category",
    "price"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.status": "active"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "administrator"
          }
        },
        {
          "user_condition": {
            "role": "super_administrator"
          }
        },
        {
          "user_condition": {
            "role": "operations_officer"
          }
        },
        {
          "user_condition": {
            "role": "operations_manager"
          }
        },
        {
          "user_condition": {
            "role": "finance_officer"
          }
        },
        {
          "user_condition": {
            "role": "treasury_officer"
          }
        },
        {
          "user_condition": {
            "role": "compliance_officer"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "administrator"
          }
        },
        {
          "user_condition": {
            "role": "super_administrator"
          }
        },
        {
          "user_condition": {
            "role": "operations_officer"
          }
        },
        {
          "user_condition": {
            "role": "operations_manager"
          }
        },
        {
          "user_condition": {
            "role": "finance_officer"
          }
        },
        {
          "user_condition": {
            "role": "treasury_officer"
          }
        },
        {
          "user_condition": {
            "role": "compliance_officer"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "administrator"
          }
        },
        {
          "user_condition": {
            "role": "super_administrator"
          }
        },
        {
          "user_condition": {
            "role": "operations_officer"
          }
        },
        {
          "user_condition": {
            "role": "operations_manager"
          }
        },
        {
          "user_condition": {
            "role": "finance_officer"
          }
        },
        {
          "user_condition": {
            "role": "treasury_officer"
          }
        },
        {
          "user_condition": {
            "role": "compliance_officer"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "administrator"
          }
        },
        {
          "user_condition": {
            "role": "super_administrator"
          }
        }
      ]
    }
  }
}
