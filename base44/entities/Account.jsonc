{
  "name": "Account",
  "type": "object",
  "properties": {
    "user_id": { "type": "string" },
    "account_number": { "type": "string" },
    "routing_number": { "type": "string", "description": "Provider-issued US ABA routing number" },
    "account_type": {
      "type": "string",
      "enum": ["Checking", "Savings", "Money Market", "CD", "Joint", "Business"]
    },
    "account_name": { "type": "string" },
    "balance": { "type": "number", "default": 0 },
    "status": { "type": "string", "enum": ["active", "frozen", "closed"], "default": "active" },
    "application_id": { "type": "string" },
    "provider": { "type": "string", "enum": ["unit"] },
    "provider_account_id": { "type": "string" },
    "provider_customer_id": { "type": "string" },
    "provider_status": { "type": "string" },
    "currency": { "type": "string", "default": "USD" },
    "available_balance": { "type": "number" },
    "last_provider_sync_at": { "type": "string", "format": "date-time" }
  },
  "required": ["user_id", "account_type", "account_name"],
  "rls": {
    "create": { "data.user_id": "{{user.id}}" },
    "read": { "data.user_id": "{{user.id}}" },
    "update": { "data.user_id": "{{user.id}}" },
    "delete": { "data.user_id": "{{user.id}}" }
  }
}
