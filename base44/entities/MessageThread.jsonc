{
  "name": "MessageThread",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "The member in this conversation thread"
    },
    "subject": {
      "type": "string",
      "description": "Thread subject, typically the original notification title"
    },
    "last_message": {
      "type": "string",
      "description": "Preview of the most recent message in the thread"
    },
    "last_sender": {
      "type": "string",
      "enum": [
        "member",
        "admin"
      ],
      "default": "member"
    },
    "last_message_date": {
      "type": "string",
      "format": "date-time"
    },
    "unread_by_member": {
      "type": "boolean",
      "default": false
    },
    "unread_by_admin": {
      "type": "boolean",
      "default": true
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "closed"
      ],
      "default": "open"
    }
  },
  "required": [
    "user_id",
    "subject"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_administrator"
          }
        },
        {
          "user_condition": {
            "role": "operations_officer"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_administrator"
          }
        },
        {
          "user_condition": {
            "role": "operations_officer"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_administrator"
          }
        },
        {
          "user_condition": {
            "role": "operations_officer"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_administrator"
          }
        }
      ]
    }
  }
}