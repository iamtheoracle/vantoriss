{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "description": "The role of the user in the app",
      "enum": [
        "user",
        "operations_officer",
        "finance_officer",
        "compliance_officer",
        "executive",
        "administrator",
        "super_administrator",
        "admin",
        "customer_support",
        "kyc_officer",
        "operations_manager",
        "treasury_officer",
        "auditor",
        "it_administrator",
        "risk_officer",
        "herobox_manager",
        "volunteer_manager",
        "shipping_manager",
        "investment_manager",
        "investment_officer"
      ],
      "default": "user"
    },
    "display_name": {
      "type": "string",
      "description": "Operator-set name shown to the member in the app (auth full_name is platform-protected)"
    },
    "username": {
      "type": "string",
      "description": "The user's chosen unique username identifier (not an email, not a full name)"
    },
    "admin_notes": {
      "type": "string",
      "description": "Internal notes accessible only by authorized operations staff"
    },
    "referral_code": {
      "type": "string",
      "description": "Unique invite code for member referral tracking"
    },
    "member_number": {
      "type": "string",
      "description": "Institutional member number issued by AVCU, used to identify the member in transfers and statements"
    },
    "member_type": {
      "type": "string",
      "enum": [
        "individual",
        "corporate"
      ],
      "default": "individual",
      "description": "Whether the membership is held by an individual or a corporate entity"
    },
    "corporate_name": {
      "type": "string",
      "description": "Registered legal entity name when member_type is corporate"
    }
  },
  "required": [
    "role"
  ]
}