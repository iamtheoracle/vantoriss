{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "description": "The role of the user in the app",
      "enum": [
        "user",
        "operations_officer",
        "finance_officer",
        "compliance_officer",
        "executive",
        "administrator",
        "super_administrator",
        "admin"
      ],
      "default": "user"
    }
  },
  "required": [
    "role"
  ]
}