{
  "name": "WithdrawalLimit",
  "type": "object",
  "properties": {
    "account_type": {
      "type": "string",
      "enum": [
        "Checking",
        "Savings",
        "Money Market",
        "CD"
      ],
      "description": "Account type this limit applies to"
    },
    "daily_limit": {
      "type": "number",
      "description": "Maximum withdrawal amount per day (USD)"
    },
    "monthly_limit": {
      "type": "number",
      "description": "Maximum withdrawal amount per month (USD)"
    },
    "single_limit": {
      "type": "number",
      "description": "Maximum withdrawal amount per single request (USD)"
    },
    "enabled": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "account_type"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_administrator"
          }
        },
        {
          "user_condition": {
            "role": "operations_officer"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_administrator"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_administrator"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_administrator"
          }
        }
      ]
    }
  }
}