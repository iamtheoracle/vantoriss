{
  "name": "HeroBoxActivity",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "activity_type": {
      "type": "string",
      "enum": [
        "sponsored",
        "request_approved",
        "package_delivered",
        "letter_received",
        "impact_report",
        "volunteer_hours",
        "internet_sponsored",
        "community_update",
        "mission_milestone"
      ]
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "amount": {
      "type": "number",
      "default": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "available",
        "pending",
        "under_review",
        "approved",
        "completed"
      ],
      "default": "completed"
    },
    "recipient_name": {
      "type": "string"
    }
  },
  "required": [
    "user_id",
    "activity_type",
    "title"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "administrator"
          }
        },
        {
          "user_condition": {
            "role": "super_administrator"
          }
        },
        {
          "user_condition": {
            "role": "operations_officer"
          }
        },
        {
          "user_condition": {
            "role": "operations_manager"
          }
        },
        {
          "user_condition": {
            "role": "finance_officer"
          }
        },
        {
          "user_condition": {
            "role": "treasury_officer"
          }
        },
        {
          "user_condition": {
            "role": "compliance_officer"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "administrator"
          }
        },
        {
          "user_condition": {
            "role": "super_administrator"
          }
        },
        {
          "user_condition": {
            "role": "operations_officer"
          }
        },
        {
          "user_condition": {
            "role": "operations_manager"
          }
        },
        {
          "user_condition": {
            "role": "finance_officer"
          }
        },
        {
          "user_condition": {
            "role": "treasury_officer"
          }
        },
        {
          "user_condition": {
            "role": "compliance_officer"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "administrator"
          }
        },
        {
          "user_condition": {
            "role": "super_administrator"
          }
        },
        {
          "user_condition": {
            "role": "operations_officer"
          }
        },
        {
          "user_condition": {
            "role": "operations_manager"
          }
        },
        {
          "user_condition": {
            "role": "finance_officer"
          }
        },
        {
          "user_condition": {
            "role": "treasury_officer"
          }
        },
        {
          "user_condition": {
            "role": "compliance_officer"
          }
        }
      ]
    },
    "delete": false
  }
}
