{
  "name": "CommunityMembership",
  "type": "object",
  "properties": {
    "community_id": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "user_name": {
      "type": "string"
    },
    "role": {
      "type": "string",
      "enum": [
        "member",
        "admin",
        "moderator"
      ],
      "default": "member"
    }
  },
  "required": [
    "community_id",
    "user_id",
    "user_name"
  ]
}