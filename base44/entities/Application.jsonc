{
  "name": "Application",
  "type": "object",
  "properties": {
    "user_id": { "type": "string", "description": "The user who submitted the application" },
    "full_name": { "type": "string" },
    "email": { "type": "string" },
    "phone": { "type": "string" },
    "account_type": { "type": "string", "enum": ["Checking", "Savings", "Money Market", "CD", "Joint", "Business"] },
    "kyc_status": { "type": "string", "enum": ["not_started", "pending", "approved", "rejected"], "default": "not_started" },
    "kyc_documents": { "type": "array", "items": { "type": "string" } },
    "kyc_notes": { "type": "string" },
    "application_status": { "type": "string", "enum": ["pending", "approved", "rejected"], "default": "pending" },
    "admin_notes": { "type": "string" },
    "opening_balance": { "type": "number", "default": 0 },
    "business_name": { "type": "string" },
    "business_type": { "type": "string", "enum": ["LLC", "Corporation", "Partnership", "Sole Proprietorship", "Non-Profit"] },
    "ein": { "type": "string" },
    "joint_account_holder_name": { "type": "string" },
    "joint_account_holder_ssn": { "type": "string" },
    "address": { "type": "string" },
    "opening_receipt_url": { "type": "string" },
    "opening_payment_method": { "type": "string", "enum": ["Direct Deposit", "ACH Transfer", "Wire Transfer", "Mobile Check Deposit", "Cashier's Check", "Personal Check"] },
    "opening_contribution_status": { "type": "string", "enum": ["not_started", "pending", "approved", "rejected"], "default": "not_started" },
    "deposit_account_details": { "type": "string" },
    "deposit_details_expires": { "type": "string", "format": "date-time" },
    "provider": { "type": "string", "enum": ["unit"] },
    "provider_application_id": { "type": "string" },
    "provider_customer_id": { "type": "string" },
    "provider_status": { "type": "string" }
  },
  "required": ["full_name", "email", "account_type"]
}
