{
  "name": "Document",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "The member who owns this document"
    },
    "title": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "statement",
        "kyc_document",
        "tax_document",
        "agreement",
        "historical_statement",
        "other"
      ],
      "default": "other"
    },
    "file_url": {
      "type": "string"
    },
    "reference_number": {
      "type": "string",
      "description": "Unique reference for statements and formal documents"
    },
    "account_id": {
      "type": "string",
      "description": "Associated account for statements"
    },
    "statement_period": {
      "type": "string",
      "description": "Date range covered, e.g. 2025-01-01 to 2025-03-31 (human-readable)"
    },
    "statement_date": {
      "type": "string",
      "format": "date",
      "description": "The actual statement date from the source (NOT the upload/created date)"
    },
    "period_start": {
      "type": "string",
      "format": "date",
      "description": "Statement period start date"
    },
    "period_end": {
      "type": "string",
      "format": "date",
      "description": "Statement period end date"
    },
    "issue_date": {
      "type": "string",
      "format": "date",
      "description": "The date the statement was issued (may differ from statement_date)"
    },
    "archived": {
      "type": "boolean",
      "default": false
    },
    "archive_reference": {
      "type": "string",
      "description": "External storage reference for archived documents"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "archived",
        "archival_failed"
      ],
      "default": "active"
    }
  },
  "required": [
    "user_id",
    "title",
    "type"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_administrator"
          }
        },
        {
          "user_condition": {
            "role": "operations_officer"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_administrator"
          }
        },
        {
          "user_condition": {
            "role": "operations_officer"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_administrator"
          }
        },
        {
          "user_condition": {
            "role": "operations_officer"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_administrator"
          }
        }
      ]
    }
  }
}