{
  "name": "SecurityCredential",
  "type": "object",
  "properties": {
    "user_id": { "type": "string" },
    "pin_hash": { "type": "string" },
    "pin_salt": { "type": "string" },
    "failed_attempts": { "type": "number", "default": 0 },
    "locked_until": { "type": "string" },
    "last_verified_at": { "type": "string" }
  },
  "required": ["user_id", "pin_hash", "pin_salt"]
}
