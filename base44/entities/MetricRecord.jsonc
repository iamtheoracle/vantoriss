{
  "name": "MetricRecord",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Metric name"
    },
    "value": {
      "type": "number"
    },
    "type": {
      "type": "string",
      "enum": [
        "counter",
        "gauge",
        "histogram",
        "timer"
      ],
      "default": "counter"
    },
    "tags": {
      "type": "string",
      "description": "JSON-serialized tags"
    }
  },
  "required": [
    "name",
    "value"
  ]
}