{
  "name": "HeroBoxOrder",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "The customer who placed this order"
    },
    "recipient_name": {
      "type": "string"
    },
    "recipient_branch": {
      "type": "string"
    },
    "destination": {
      "type": "string"
    },
    "destination_address": {
      "type": "string"
    },
    "items": {
      "type": "string",
      "description": "JSON-serialized order items"
    },
    "package_id": {
      "type": "string"
    },
    "subtotal": {
      "type": "number",
      "default": 0
    },
    "discount": {
      "type": "number",
      "default": 0
    },
    "shipping_cost": {
      "type": "number",
      "default": 0
    },
    "service_costs": {
      "type": "number",
      "default": 0
    },
    "total": {
      "type": "number",
      "default": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "payment_pending",
        "paid",
        "processing",
        "packed",
        "shipped",
        "in_transit",
        "delivered",
        "exception",
        "cancelled",
        "refunded"
      ],
      "default": "draft"
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "pending",
        "completed",
        "failed",
        "refunded"
      ],
      "default": "pending"
    },
    "payment_account_id": {
      "type": "string"
    },
    "tracking_number": {
      "type": "string"
    },
    "estimated_delivery": {
      "type": "string",
      "format": "date"
    },
    "shipped_date": {
      "type": "string",
      "format": "date"
    },
    "delivered_date": {
      "type": "string",
      "format": "date"
    },
    "order_notes": {
      "type": "string"
    }
  },
  "required": [
    "user_id",
    "recipient_name",
    "destination"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "administrator"
          }
        },
        {
          "user_condition": {
            "role": "super_administrator"
          }
        },
        {
          "user_condition": {
            "role": "operations_officer"
          }
        },
        {
          "user_condition": {
            "role": "operations_manager"
          }
        },
        {
          "user_condition": {
            "role": "finance_officer"
          }
        },
        {
          "user_condition": {
            "role": "treasury_officer"
          }
        },
        {
          "user_condition": {
            "role": "compliance_officer"
          }
        }
      ]
    },
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "administrator"
          }
        },
        {
          "user_condition": {
            "role": "super_administrator"
          }
        },
        {
          "user_condition": {
            "role": "operations_officer"
          }
        },
        {
          "user_condition": {
            "role": "operations_manager"
          }
        },
        {
          "user_condition": {
            "role": "finance_officer"
          }
        },
        {
          "user_condition": {
            "role": "treasury_officer"
          }
        },
        {
          "user_condition": {
            "role": "compliance_officer"
          }
        }
      ]
    },
    "delete": false
  }
}
