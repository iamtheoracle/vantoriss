{
  "name": "WorkflowRun",
  "type": "object",
  "properties": {
    "workflow_name": { "type": "string" },
    "workflow_version": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["prepared", "pending_approval", "approved", "rejected", "executing", "completed", "failed", "blocked", "cancelled"]
    },
    "requester_id": { "type": "string" },
    "subject_user_id": { "type": "string" },
    "idempotency_key": { "type": "string" },
    "current_step": { "type": "string" },
    "payload_json": { "type": "string" },
    "evidence_json": { "type": "string" },
    "approval_json": { "type": "string" },
    "result_json": { "type": "string" },
    "event_log_json": { "type": "string" },
    "execution_enabled": { "type": "boolean", "default": false },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" }
  },
  "required": ["workflow_name", "workflow_version", "status", "requester_id", "idempotency_key"],
  "rls": {
    "create": false,
    "read": {
      "$or": [
        { "data.requester_id": "{{user.id}}" },
        { "user_condition": { "role": "admin" } },
        { "user_condition": { "role": "administrator" } },
        { "user_condition": { "role": "super_administrator" } },
        { "user_condition": { "role": "compliance_officer" } },
        { "user_condition": { "role": "operations_manager" } },
        { "user_condition": { "role": "finance_officer" } },
        { "user_condition": { "role": "treasury_officer" } },
        { "user_condition": { "role": "kyc_officer" } },
        { "user_condition": { "role": "investment_officer" } }
      ]
    },
    "update": false,
    "delete": false
  }
}
