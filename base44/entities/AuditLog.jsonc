{
  "name": "AuditLog",
  "type": "object",
  "properties": {
    "account_id": {
      "type": "string",
      "description": "The account affected by this action"
    },
    "user_id": {
      "type": "string",
      "description": "The admin who performed the action"
    },
    "admin_name": {
      "type": "string",
      "description": "Display name of the admin"
    },
    "action_type": {
      "type": "string",
      "enum": [
        "transaction_created",
        "transaction_edited",
        "balance_adjusted",
        "withdrawal_processed",
        "withdrawal_rejected",
        "account_created",
        "account_status_changed",
        "application_approved",
        "application_rejected",
        "kyc_approved",
        "kyc_rejected",
        "super_admin_exception_auth",
        "recommendation_created",
        "workflow_approved",
        "workflow_rejected"
      ],
      "description": "The type of administrative action performed"
    },
    "description": {
      "type": "string",
      "description": "Human-readable summary of what happened"
    },
    "details": {
      "type": "string",
      "description": "Additional context \u2014 notes, references, prior values. For exception auth events: JSON with action, target, result, execution_result. NEVER includes the credential/secret."
    },
    "amount": {
      "type": "number",
      "description": "Transaction amount if applicable (negative for debits)"
    },
    "balance_before": {
      "type": "number",
      "description": "Account balance before the action"
    },
    "balance_after": {
      "type": "number",
      "description": "Account balance after the action"
    },
    "target_user_id": {
      "type": "string",
      "description": "The member affected (for application/KYC actions)"
    }
  },
  "required": [
    "action_type",
    "description"
  ],
  "rls": {
    "create": false,
    "read": {
      "$or": [
        { "user_condition": { "role": "admin" } },
        { "user_condition": { "role": "administrator" } },
        { "user_condition": { "role": "super_administrator" } },
        { "user_condition": { "role": "operations_officer" } },
        { "user_condition": { "role": "operations_manager" } },
        { "user_condition": { "role": "compliance_officer" } },
        { "user_condition": { "role": "executive" } },
        { "user_condition": { "role": "finance_officer" } },
        { "user_condition": { "role": "kyc_officer" } },
        { "user_condition": { "role": "treasury_officer" } },
        { "user_condition": { "role": "investment_officer" } },
        { "user_condition": { "role": "investment_manager" } },
        { "user_condition": { "role": "auditor" } },
        { "user_condition": { "role": "risk_officer" } },
        { "user_condition": { "role": "it_administrator" } },
        { "user_condition": { "role": "customer_support" } },
        { "user_condition": { "role": "herobox_manager" } },
        { "user_condition": { "role": "volunteer_manager" } },
        { "user_condition": { "role": "shipping_manager" } }
      ]
    },
    "update": false,
    "delete": false
  }
}